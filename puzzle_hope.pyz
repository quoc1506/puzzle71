#!/usr/bin/env python3
import base64, hashlib, sys, struct, types

def _m():
    return struct.unpack('<I', base64.b64decode('AAAAAA=='))[0]

def _g(key_len):
    _magic = _m()
    _a = 0x9E3779B9
    _b = 0x85EBCA6B
    _c = 0xC2B2AE35
    _s = ((_a ^ _b) + _c) & 0xFFFFFFFF
    _s = (_s ^ _magic) & 0xFFFFFFFFFFFFFFFF
    _k = bytearray()
    _state = _s
    for _i in range(key_len):
        _state = (_state * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
        _k.append((_state >> 56) & 0xFF)
        _state ^= (_state >> 23)
    return bytes(_k)

def _load_encrypted(name, payload_b64, key_len):
    _p = base64.b64decode(payload_b64)
    _k = _g(key_len)
    _x = bytes(_p[_i] ^ _k[_i % len(_k)] for _i in range(len(_p)))
    if hashlib.sha256(_x[4:]).digest()[:4] != _x[:4]:
        sys.exit(1)
    _source = _x[4:].decode("utf-8")
    _code = compile(_source, name + ".pyz", "exec")
    _mod = types.ModuleType(name)
    _mod.__file__ = name + '.pyz'
    exec(_code, _mod.__dict__)
    sys.modules[name] = _mod
    return _mod

